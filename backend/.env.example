APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://parcelpilot:parcelpilot_local@localhost:5432/parcelpilot
SESSION_COOKIE_NAME=parcelpilot_session
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_TOKEN_PEPPER=replace-with-a-long-random-value
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_TOOL_STEPS=6
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMENT_TOP_K=6
RAG_CHUNK_TOKENS=750
RAG_CHUNK_OVERLAP_TOKENS=100
DATA_PACK_DIR=../data/raw
DATA_MANIFEST_PATH=../data/manifest.yml
ACTION_CONFIRMATION_TTL_MINUTES=15
LOG_LEVEL=INFO
LOG_FORMAT=json
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CHAT=20/minute
DEMO_USER_PASSWORD=ParcelPilotDemo!
